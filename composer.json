{
    "name": "uams-web/uamswp-srm-editor-access",
    "description": "Allows users with the Editor role to access and manage redirects in the UAMSWP Safe Redirect Manager plugin.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "brain/monkey": "^2.7",
        "laravel/pint": "^1.32",
        "pestphp/pest": "^5.3",
        "php-stubs/wordpress-stubs": "^6.8",
        "phpstan/phpstan": "^2.3",
        "rector/rector": "^2.8",
        "szepeviktor/phpstan-wordpress": "^2.0"
    },
    "config": {
        "platform": {
            "php": "8.4.27"
        },
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "@test:unit",
        "test:unit": "pest",
        "mutate": "pest --mutate --everything --path=uamswp-srm-editor-access.php",
        "pint": "pint",
        "test:pint": "pint --test",
        "refactor": "rector",
        "test:refactor": "rector --dry-run",
        "stan": "phpstan analyse --no-progress --memory-limit=2G"
    },
    "scripts-descriptions": {
        "test": "Run the test suite.",
        "test:unit": "Run the Pest suite that needs no WordPress and no database.",
        "mutate": "Run Pest mutation testing over the plugin file.",
        "pint": "Format the first-party PHP with Pint.",
        "test:pint": "Check the formatting without changing files.",
        "refactor": "Apply the Rector gating profile.",
        "test:refactor": "Preview the Rector gating profile.",
        "stan": "Run PHPStan."
    }
}
